# Copy to backend/.env and fill in. scripts/setup.ps1 creates .env automatically
# with a random SECRET_KEY if it doesn't exist.

# Where sermons, clips, the database, models and logs are stored
DATA_DIR=D:/Sermons

# Signs login sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Optional settings (defaults shown)
# ALLOW_REGISTRATION=false
# LLM_MODEL=qwen2.5:7b-instruct
# EMBED_MODEL=nomic-embed-text
# WHISPER_MODEL=large-v3-turbo
# VIDEO_ENCODER=auto
# MAX_UPLOAD_GB=20
# MAX_DURATION_HOURS=6
